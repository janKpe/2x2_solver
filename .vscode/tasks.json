{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: build (Debug)",
            "type": "shell",
            "command": "cmake -S ${workspaceFolder} -B ${workspaceFolder}/build -DCMAKE_BUILD_TYPE=Debug -DOPTIMIZE=OFF && cmake --build ${workspaceFolder}/build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Rebuild with cmake before debugging"
        }
    ]
}
